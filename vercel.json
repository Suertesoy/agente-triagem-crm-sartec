{
  "version": 2,
  "rewrites": [
    {
      "source": "/painel",
      "destination": "/painel/index.html"
    },
    {
      "source": "/painel/",
      "destination": "/painel/index.html"
    },
    {
      "source": "/painel/(.*)",
      "destination": "/painel/$1"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    }
  ],
  "functions": {
    "api/send.js": {
      "includeFiles": "node_modules/ffmpeg-static/**",
      "maxDuration": 20
    }
  },
  "crons": [
    {
      "path": "/api/agent-burst-sweep",
      "schedule": "* * * * *"
    }
  ]
}
