# Operação atual (mantida como fonte principal nesta etapa)
REDIS_URL=redis://user:password@host:6379

# Agregação/debounce do turno PF pré-handoff (opcional — defaults seguros já
# cobrem o caso sem configurar nada no Vercel). Ver lib/agent-burst.js.
AGENT_BURST_QUIET_MS=60000
AGENT_BURST_MAX_MS=180000

# Protege /api/agent-burst-sweep (alvo do Vercel Cron Job) — opcional, mas
# recomendado em produção. Vercel envia este valor automaticamente como
# header Authorization quando configurado no projeto.
CRON_SECRET=replace-with-a-random-string-16-chars-or-more

# Supabase exclusivo do CRM Sartec — nunca use credenciais do site
SUPABASE_CRM_ENABLED=false
SUPABASE_DUAL_WRITE=false
SUPABASE_SHADOW_TIMEOUT_MS=2000
SUPABASE_CRM_URL=https://uzwyzwbybtnvgjjhimwy.supabase.co
SUPABASE_CRM_SERVICE_ROLE_KEY=replace-with-sartec-crm-service-role-key
